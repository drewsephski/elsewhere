# Shared Postgres (hosted role search_path selects elsewhere_control; local uses public)
DATABASE_URL=

# Better Auth — dedicated `auth` schema via search_path (run: pnpm --filter @elsewhere/www auth:migrate)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_DATABASE_URL=
# Hosted Supabase MUST use elsewhere_auth; auth is a Supabase-managed schema.
# Keep auth locally to preserve existing development accounts.
BETTER_AUTH_DATABASE_SCHEMA=auth
# Hosted signup requires a private invitation. Set the public flag at build AND runtime.
NEXT_PUBLIC_ELSEWHERE_ALPHA_INVITE_REQUIRED=0
ELSEWHERE_ALPHA_INVITE_CODE=

# Web app -> cloud-host
# Canonical server-side BFF upstream. Hosted/self-hosted deployments should set this at runtime.
# It may be a private service URL because browsers never call it directly.
ELSEWHERE_CLOUD_HOST_URL=http://127.0.0.1:8080
# Legacy hosted variable kept for backwards compatibility; prefer ELSEWHERE_CLOUD_HOST_URL.
ELSEWHERE_CLOUD_HOST_INTERNAL_URL=
# Build/public compatibility fallback for older deployments. New browser traffic uses /api/cloud/*.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_ELSEWHERE_CLOUD_HOST_URL=http://127.0.0.1:8080
NEXT_PUBLIC_ELSEWHERE_JWT_AUDIENCE=elsewhere-cloud-host
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

# Desktop (Tauri) — Vite dev shell on :1420 proxies /api to the Next.js app on :3000.
# Better Auth must trust the shell origin or sign-in from the desktop app fails CSRF checks.
# ELSEWHERE_DESKTOP_TRUSTED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420
# Optional: packaged app loads the hosted workspace (recommended for alpha) instead of bundled assets.
# ELSEWHERE_DESKTOP_WEBVIEW_URL=https://elsewhere-alpha-web.fly.dev/app

# Optional Google OAuth (server); set NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=1 when configured
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# cloud-host
# Tokio stall watchdog: off by default in debug `cargo run`; set 1 for release-like local testing.
ELSEWHERE_RUNTIME_STALL_WATCHDOG=
# ELSEWHERE_RUNTIME_STALL_SECS=20
OPENAI_API_KEY=
SPRITE_TOKEN=
ELSEWHERE_CLOUD_API_TOKEN=
ELSEWHERE_AUTH_MODE=hybrid
ELSEWHERE_JWT_ISSUER=http://localhost:3000
ELSEWHERE_JWT_AUDIENCE=elsewhere-cloud-host
ELSEWHERE_JWT_JWKS_URL=http://localhost:3000/api/auth/jwks
ELSEWHERE_WEB_ORIGIN=http://localhost:3000
# Hybrid local dev defaults to enabled; set 0 to disable. Jwt/production must set 1 explicitly.
ELSEWHERE_ALLOW_CODEX_LOGIN=1
ELSEWHERE_TEST_SPRITE=
ELSEWHERE_MAX_CONCURRENT_RUNS=10
ELSEWHERE_RUN_TIMEOUT_SECS=900
RUST_LOG=elsewhere=info

# Durable host-only Codex profile volume. Required for product ChatGPT connections.
# Do not mount this into agent computers or use the operator's personal Codex home.
# Hybrid local dev defaults to <repo>/.data/codex-profiles when unset.
# Relative values are resolved to absolute against the process cwd.
# Must resolve to a writable absolute path on the host (not inside an agent sandbox volume).
# Example for local absolute override: ELSEWHERE_CODEX_PROFILES_DIR=$HOME/.elsewhere/codex-profiles
ELSEWHERE_CODEX_PROFILES_DIR=.data/codex-profiles

# Durable host-only browser (Chromium) sign-in profiles, keyed by computer.
# Hosted runners MUST set an absolute path on a persistent volume that the service user can write
# (Fly alpha: /var/lib/elsewhere/browser-profiles, declared in infra/fly/runner.toml).
# Leave empty locally to default to <repo>/.data/browser-profiles (resolved absolute against cwd).
# Must resolve to a writable absolute path on the host (not inside an agent sandbox volume).
# Example for local absolute override: ELSEWHERE_BROWSER_PROFILES_DIR=$HOME/.elsewhere/browser-profiles
ELSEWHERE_BROWSER_PROFILES_DIR=

# AES-256-GCM key (base64 32 bytes) for GitHub/MCP/Slack token encryption.
ELSEWHERE_CONNECTOR_SECRET_KEY=

# GitHub App user-token connection (Elsewhere Alpha). These are GitHub App
# Client ID / Client Secret values, not classic OAuth App credentials.
# Do not set GITHUB_APP_PRIVATE_KEY; this slice uses user tokens only.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/app/connectors/github/callback
# GITHUB_APP_SLUG=elsewhere-alpha

# HMAC key (base64 32 bytes) for local Mac pairing secrets and durable device credentials.
# Required when ELSEWHERE_AUTH_MODE=jwt. Hybrid/local may omit it.
ELSEWHERE_LOCAL_MAC_CREDENTIAL_KEY=

# Slack Agent Channels (optional until you connect Slack)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://localhost:3000/app/channels/slack/callback
# Optional override for tests; defaults to https://slack.com/api
# SLACK_API_BASE=

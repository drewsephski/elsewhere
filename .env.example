# Shared Postgres (SQLx cloud-host uses public schema migrations)
DATABASE_URL=

# Better Auth — dedicated `auth` schema via search_path (run: pnpm --filter @elsewhere/www auth:migrate)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_DATABASE_URL=

# Public www → cloud-host
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_ELSEWHERE_CLOUD_HOST_URL=http://127.0.0.1:8080
NEXT_PUBLIC_ELSEWHERE_JWT_AUDIENCE=elsewhere-cloud-host
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

# Optional Google OAuth (server); set NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=1 when configured
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# cloud-host
OPENAI_API_KEY=
SPRITE_TOKEN=
ELSEWHERE_CLOUD_API_TOKEN=
ELSEWHERE_AUTH_MODE=hybrid
ELSEWHERE_JWT_ISSUER=http://localhost:3000
ELSEWHERE_JWT_AUDIENCE=elsewhere-cloud-host
ELSEWHERE_JWT_JWKS_URL=http://localhost:3000/api/auth/jwks
ELSEWHERE_WEB_ORIGIN=http://localhost:3000
ELSEWHERE_ALLOW_CODEX_LOGIN=
ELSEWHERE_TEST_SPRITE=
ELSEWHERE_MAX_CONCURRENT_RUNS=10
ELSEWHERE_RUN_TIMEOUT_SECS=900
RUST_LOG=elsewhere=info
